    "eslint-plugin-unicorn": "^76.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.8",
    "sass": "^1.104.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
